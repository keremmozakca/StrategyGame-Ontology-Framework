        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#BuildTroop -->


    <owl:Class rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#BuildTroop">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Collapsed -->


    <owl:Class rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Collapsed">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#GameState"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Defend -->


    <owl:Class rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Defend">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Entity -->


    <owl:Class rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Entity"/>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#ExpansionPhase -->


    <owl:Class rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#ExpansionPhase">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#GameState"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#threatLevel"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#threatLevel"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</xsd:maxInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#GameState"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Food -->


    <owl:Class rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Food">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Resource"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#GameState -->


    <owl:Class rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#GameState"/>
    


