<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#"
     xml:base="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->


    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#hasResource -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#hasResource">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Entity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Resource"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#hasState -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#hasState">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Entity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#GameState"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#hasTarget -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#hasTarget">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Entity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#isAlliedWith -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#isAlliedWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Entity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Entity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#isVassalOf -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#isVassalOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Entity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Entity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#offersAllianceTo -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#offersAllianceTo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Entity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Entity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#offersVassalageTo -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#offersVassalageTo">
