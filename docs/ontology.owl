    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#healthPoints -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#healthPoints">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#resourceAmount -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#resourceAmount">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Resource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#threatLevel -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#threatLevel">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#GameState"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


