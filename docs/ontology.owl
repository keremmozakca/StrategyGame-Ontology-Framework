    </owl:Class>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action -->


    <owl:Class rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action"/>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Attack -->


