        <rdfs:range rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Entity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#recommendedAction -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#recommendedAction">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Entity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#requestsAidFrom -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#requestsAidFrom">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Entity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Entity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2002/07/owl#differentFrom -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2002/07/owl#differentFrom"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
