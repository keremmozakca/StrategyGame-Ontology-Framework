        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#AcceptVassalage -->


    <owl:Class rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#AcceptVassalage">
