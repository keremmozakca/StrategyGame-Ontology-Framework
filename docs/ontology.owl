    </owl:Class>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Resource -->


    <owl:Class rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Resource"/>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#ResourceCritical -->


    <owl:Class rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#ResourceCritical">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#GameState"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Retreat -->


    <owl:Class rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Retreat">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Safe -->


    <owl:Class rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Safe">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#GameState"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#threatLevel"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</xsd:maxInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#GameState"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Troop -->


    <owl:Class rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Troop">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Resource"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#UnderAttack -->


    <owl:Class rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#UnderAttack">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#GameState"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#threatLevel"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#GameState"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Vassal -->


    <owl:Class rdf:about="http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Vassal">
