                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasState ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> <http://www.semanticweb.org/keremozakca/ontologies/2026/4/untitled-ontology-19/e1> ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> <http://www.semanticweb.org/keremozakca/ontologies/2026/4/untitled-ontology-19/s>
                                                                ] ;
