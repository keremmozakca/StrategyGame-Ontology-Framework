@prefix : <http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#> .

<http://www.semanticweb.org/cse3226/strategy-game-ontology/v2> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#hasResource
:hasResource rdf:type owl:ObjectProperty ;
             rdfs:domain :Entity ;
             rdfs:range :Resource .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#hasState
:hasState rdf:type owl:ObjectProperty ;
          rdfs:domain :Entity ;
          rdfs:range :GameState .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#hasTarget
:hasTarget rdf:type owl:ObjectProperty ,
                    owl:IrreflexiveProperty ;
           rdfs:domain :Action ;
           rdfs:range :Entity .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#isAlliedWith
:isAlliedWith rdf:type owl:ObjectProperty ,
                       owl:SymmetricProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain :Entity ;
              rdfs:range :Entity .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#isVassalOf
:isVassalOf rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ,
                     owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain :Entity ;
            rdfs:range :Entity .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#offersAllianceTo
:offersAllianceTo rdf:type owl:ObjectProperty ;
                  rdfs:domain :Entity ;
                  rdfs:range :Entity .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#offersVassalageTo
:offersVassalageTo rdf:type owl:ObjectProperty ;
                   rdfs:domain :Entity ;
                   rdfs:range :Entity .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#recommendedAction
:recommendedAction rdf:type owl:ObjectProperty ;
                   rdfs:domain :Entity ;
                   rdfs:range :Action .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#requestsAidFrom
:requestsAidFrom rdf:type owl:ObjectProperty ;
                 rdfs:domain :Entity ;
                 rdfs:range :Entity .


###  http://www.w3.org/2002/07/owl#differentFrom
owl:differentFrom rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#healthPoints
:healthPoints rdf:type owl:DatatypeProperty ;
              rdfs:domain :Entity ;
              rdfs:range xsd:integer .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#resourceAmount
:resourceAmount rdf:type owl:DatatypeProperty ;
                rdfs:domain :Resource ;
                rdfs:range xsd:integer .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#threatLevel
:threatLevel rdf:type owl:DatatypeProperty ;
             rdfs:domain :GameState ;
             rdfs:range xsd:integer .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#AcceptAid
:AcceptAid rdf:type owl:Class ;
           rdfs:subClassOf :Action .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#AcceptAlliance
:AcceptAlliance rdf:type owl:Class ;
                rdfs:subClassOf :Action .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#AcceptVassalage
:AcceptVassalage rdf:type owl:Class ;
                 rdfs:subClassOf :Action .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action
:Action rdf:type owl:Class .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Attack
:Attack rdf:type owl:Class ;
        rdfs:subClassOf :Action .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#BreakAlliance
:BreakAlliance rdf:type owl:Class ;
               rdfs:subClassOf :Action .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#BuildTroop
:BuildTroop rdf:type owl:Class ;
            rdfs:subClassOf :Action .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Collapsed
:Collapsed rdf:type owl:Class ;
           rdfs:subClassOf :GameState .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Defend
:Defend rdf:type owl:Class ;
        rdfs:subClassOf :Action .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Entity
:Entity rdf:type owl:Class .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#ExpansionPhase
:ExpansionPhase rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :GameState
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :threatLevel ;
                                                             owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                  owl:onDatatype xsd:integer ;
                                                                                  owl:withRestrictions ( [ xsd:minInclusive 4
                                                                                                         ]
                                                                                                       )
                                                                                ]
                                                           ]
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :threatLevel ;
                                                             owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                  owl:onDatatype xsd:integer ;
                                                                                  owl:withRestrictions ( [ xsd:maxInclusive 7
                                                                                                         ]
                                                                                                       )
                                                                                ]
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf :GameState .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Food
:Food rdf:type owl:Class ;
      rdfs:subClassOf :Resource .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#GameState
:GameState rdf:type owl:Class .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#GatherResource
:GatherResource rdf:type owl:Class ;
                rdfs:subClassOf :Action .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Gold
:Gold rdf:type owl:Class ;
      rdfs:subClassOf :Resource .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#NPC
:NPC rdf:type owl:Class ;
     rdfs:subClassOf :Entity .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#OfferAlliance
:OfferAlliance rdf:type owl:Class ;
               rdfs:subClassOf :Action .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#OfferVassalage
:OfferVassalage rdf:type owl:Class ;
                rdfs:subClassOf :Action .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Player
:Player rdf:type owl:Class ;
        rdfs:subClassOf :Entity .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#RejectAid
:RejectAid rdf:type owl:Class ;
           rdfs:subClassOf :Action .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#RejectAlliance
:RejectAlliance rdf:type owl:Class ;
                rdfs:subClassOf :Action .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#RejectVassalage
:RejectVassalage rdf:type owl:Class ;
                 rdfs:subClassOf :Action .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#RequestAid
:RequestAid rdf:type owl:Class ;
            rdfs:subClassOf :Action .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Resource
:Resource rdf:type owl:Class .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#ResourceCritical
:ResourceCritical rdf:type owl:Class ;
                  rdfs:subClassOf :GameState .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Retreat
:Retreat rdf:type owl:Class ;
         rdfs:subClassOf :Action .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Safe
:Safe rdf:type owl:Class ;
      owl:equivalentClass [ owl:intersectionOf ( :GameState
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty :threatLevel ;
                                                   owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                        owl:onDatatype xsd:integer ;
                                                                        owl:withRestrictions ( [ xsd:maxInclusive 3
                                                                                               ]
                                                                                             )
                                                                      ]
                                                 ]
                                               ) ;
                            rdf:type owl:Class
                          ] ;
      rdfs:subClassOf :GameState .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Troop
:Troop rdf:type owl:Class ;
       rdfs:subClassOf :Resource .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#UnderAttack
:UnderAttack rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :GameState
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :threatLevel ;
                                                          owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                               owl:onDatatype xsd:integer ;
                                                                               owl:withRestrictions ( [ xsd:minInclusive 8
                                                                                                      ]
                                                                                                    )
                                                                             ]
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:subClassOf :GameState .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Vassal
:Vassal rdf:type owl:Class ;
        rdfs:subClassOf :GameState .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action_AcceptAid
:Action_AcceptAid rdf:type owl:NamedIndividual ,
                           :AcceptAid .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action_AcceptAlliance
:Action_AcceptAlliance rdf:type owl:NamedIndividual ,
                                :AcceptAlliance .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action_AcceptVassalage
:Action_AcceptVassalage rdf:type owl:NamedIndividual ,
                                 :AcceptVassalage .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action_Attack
:Action_Attack rdf:type owl:NamedIndividual ,
                        :Attack .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action_BreakAlliance
:Action_BreakAlliance rdf:type owl:NamedIndividual ,
                               :BreakAlliance .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action_BuildTroop
:Action_BuildTroop rdf:type owl:NamedIndividual ,
                            :BuildTroop .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action_Defend_Castle
:Action_Defend_Castle rdf:type owl:NamedIndividual ,
                               :Defend .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action_GatherResource
:Action_GatherResource rdf:type owl:NamedIndividual ,
                                :GatherResource .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action_OfferAlliance
:Action_OfferAlliance rdf:type owl:NamedIndividual ,
                               :OfferAlliance .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action_OfferVassalage
:Action_OfferVassalage rdf:type owl:NamedIndividual ,
                                :OfferVassalage .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action_RejectAid
:Action_RejectAid rdf:type owl:NamedIndividual ,
                           :RejectAid .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action_RejectAlliance
:Action_RejectAlliance rdf:type owl:NamedIndividual ,
                                :RejectAlliance .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action_RejectVassalage
:Action_RejectVassalage rdf:type owl:NamedIndividual ,
                                 :RejectVassalage .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action_RequestAid
:Action_RequestAid rdf:type owl:NamedIndividual ,
                            :RequestAid .


###  http://www.semanticweb.org/cse3226/strategy-game-ontology/v2#Action_Retreat
:Action_Retreat rdf:type owl:NamedIndividual ,
                         :Retreat .


#################################################################
#    Rules
#################################################################

