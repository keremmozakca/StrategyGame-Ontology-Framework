                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :Entity ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> <http://www.semanticweb.org/keremozakca/ontologies/2026/4/untitled-ontology-19/e1>
                                                     ] ;
